---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
import { NAV, SITE_TITLE } from "../lib/copy";

interface Props {
  title: string;
  description?: string;
  docs?: boolean;
}

const {
  title,
  description = "A benchmark for whether a web agent’s learned skills still execute after the website itself has evolved.",
  docs = false,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/instrument-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("ssb-theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body class="text-ink antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div
        class="relative z-10 mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3"
      >
        <a
          href="/"
          class="inline-flex min-h-11 items-center gap-2 font-sans text-sm font-semibold tracking-tight"
        >
          <BrandMark />
          <span translate="no">{SITE_TITLE}</span>
        </a>
        <nav aria-label="Site" class="site-nav hidden md:block">
          <ul class="flex gap-6 text-xs font-semibold uppercase tracking-[0.14em]">
            {
              NAV.map((item) => {
                const active =
                  item.href === "/"
                    ? path === "/"
                    : path === item.href || path.startsWith(item.href + "/");
                return (
                  <li>
                    <a
                      href={item.href}
                      class="inline-block px-3 py-1"
                      aria-current={active ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
        <div class="flex items-center gap-3">
          <button
            type="button"
            class="btn-ghost"
            data-theme-toggle
            aria-label="Switch color theme"
          >
            Dark
          </button>
          <a
            class="btn-canary github-cta text-xs"
            href="https://github.com/SkillShift-Bench"
            >GitHub →</a
          >
          <details class="relative md:hidden">
            <summary class="btn-ghost cursor-pointer list-none">Menu</summary>
            <ul
              class="hard-card absolute right-0 mt-2 min-w-44 p-3 text-sm text-ink"
            >
              {
                NAV.map((item) => (
                  <li class="py-1">
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </div>
    </header>
    <p class="stage-wordmark" aria-hidden="true">SKILLSHIFT</p>
    <div class="stage-banner" aria-hidden="true"></div>
    <main
      id="main"
      class:list={[
        "relative mx-auto max-w-6xl px-4 py-8",
        docs && "max-w-none px-0 py-0",
      ]}
    >
      <slot />
    </main>
    <footer class="site-footer">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 font-mono text-xs uppercase tracking-wide"
      >
        <p>
          {SITE_TITLE} · 355 families · 6 conditions
        </p>
        <span class="sticker is-plate">10 / slot</span>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.querySelector("[data-theme-toggle]");
        if (!btn) return;
        function label() {
          var t = document.documentElement.getAttribute("data-theme");
          btn.textContent = t === "dark" ? "Light" : "Dark";
        }
        label();
        btn.addEventListener("click", function () {
          var next =
            document.documentElement.getAttribute("data-theme") === "dark"
              ? "light"
              : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("ssb-theme", next);
          } catch (e) {}
          label();
        });
      })();
    </script>
    <script>
      const COPY_MS = 1600;

      async function copyText(text: string) {
        const fallback = () => {
          const field = document.createElement("textarea");
          field.value = text;
          field.setAttribute("readonly", "");
          field.style.position = "fixed";
          field.style.left = "-9999px";
          document.body.append(field);
          field.select();
          const ok = document.execCommand("copy");
          field.remove();
          return ok;
        };
        try {
          await Promise.race([
            navigator.clipboard.writeText(text),
            new Promise<never>((_, reject) => {
              window.setTimeout(() => reject(new Error("clipboard-timeout")), 400);
            }),
          ]);
          return true;
        } catch {
          return fallback();
        }
      }

      document.addEventListener("click", async (event) => {
        const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
          ".code-copy",
        );
        if (!btn) return;
        const pre = btn.closest(".code-window")?.querySelector("pre");
        const text = (pre?.textContent ?? "").replace(/\n$/, "");
        if (!text) return;
        const ok = await copyText(text);
        if (!ok) return;
        const prior = btn.dataset.label || btn.textContent || "Copy";
        btn.dataset.label = prior;
        btn.textContent = "Copied";
        btn.classList.add("is-copied");
        btn.setAttribute("aria-label", "Copied");
        const priorTimer = Number(btn.dataset.timer || "");
        if (priorTimer) window.clearTimeout(priorTimer);
        btn.dataset.timer = String(
          window.setTimeout(() => {
            btn.textContent = btn.dataset.label || "Copy";
            btn.classList.remove("is-copied");
            btn.setAttribute("aria-label", "Copy code");
          }, COPY_MS),
        );
      });
    </script>
  </body>
</html>
