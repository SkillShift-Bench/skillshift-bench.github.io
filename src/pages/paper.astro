---
import Base from "../layouts/Base.astro";
import OsWindow from "../components/OsWindow.astro";
import {
  ARXIV_STAMP,
  BIBTEX,
  PAPER_AUTHORS,
  PAPER_TITLE,
} from "../lib/copy";
---

<Base title="Paper">
  <OsWindow filename="paper.cover" badge="Waiting">
    <p class="font-mono text-xs uppercase tracking-[0.14em]">Waiting channel</p>
    <h1 class="mt-2 max-w-3xl font-serif text-3xl leading-snug">{PAPER_TITLE}</h1>
    <p class="mt-3">{PAPER_AUTHORS}</p>
    <p class="sticker is-canary mt-6">{ARXIV_STAMP}</p>
    <p class="mt-6 max-w-2xl font-serif">
      AWM 50.07 → src-exec 22.45 → tgt-exec 16.90. Learned skills hold on the
      original site and fail when execution is the thing that moved. When an arXiv
      identifier exists, this stamp becomes the identifier and a PDF link; the
      layout does not change.
    </p>
    <p class="mt-3 font-mono text-sm">ACL Anthology identifier not assigned yet.</p>
  </OsWindow>

  <OsWindow class="mt-10" filename="paper.figures" badge="Appendix">
    <figure class="paper-fig">
      <img
        src="/figures/shift.svg"
        alt="Paper figure of three controlled shift modes"
        width="1600"
        height="791"
        loading="lazy"
      />
      <figcaption>
        Paper figure: Contextual, Perceptual, and Execution shifts.
      </figcaption>
    </figure>
  </OsWindow>

  <OsWindow class="mt-10" filename="cite.bib" badge="BibTeX">
    <h2 class="text-xl">BibTeX</h2>
    <pre class="mt-3 overflow-x-auto border-[3px] border-ink bg-titlebar p-4 font-mono text-sm"><code>{BIBTEX}</code></pre>
  </OsWindow>
</Base>
