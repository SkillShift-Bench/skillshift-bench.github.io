---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Faceplate from "../components/Faceplate.astro";
import OsWindow from "../components/OsWindow.astro";
import ShiftRig from "../components/ShiftRig.astro";
import SlopeChart from "../components/SlopeChart.astro";
import {
  BIBTEX,
  BOUNDARY,
  GETTING_STARTED,
  HERO_SENTENCE,
  SITE_TITLE,
} from "../lib/copy";
import { cellsForMetric, formatNumber, getSlotValue, isExecSlot } from "../lib/cells";
import { CONDITIONS } from "../lib/constants";
import { displayModel, MINI_ENTRIES, MIXED_ENTRIES } from "../lib/submissions";
import { slopeCaption, slopeChartPayload } from "../lib/slope";
import { SITE_COUNTS } from "../lib/families";

const series = [...MIXED_ENTRIES, ...MINI_ENTRIES];
const defaultSlug = "awm--mixed";
const mixedChart = slopeChartPayload(
  MIXED_ENTRIES,
  "SR by condition — mixed backbones",
  "skillshift-sr-mixed",
);
const miniChart = slopeChartPayload(
  MINI_ENTRIES,
  "SR by condition — gpt-5-mini",
  "skillshift-sr-mini",
);

function overall(entry: (typeof series)[number]) {
  return getSlotValue(entry.json.metrics.SR, "overall");
}

function seriesKey(slug: string): string {
  if (slug === "asi--gpt-5-mini") return "asi-mini";
  if (slug === "mpcr--gpt-5-mini") return "mpcr";
  return slug.replace(/--mixed$/, "").replace(/--/g, "-");
}

function overallText(entry: (typeof series)[number]) {
  const value = overall(entry);
  return value === null ? "—" : formatNumber(value);
}

const banks = [
  { id: "mixed" as const, label: "Mixed backbones", entries: MIXED_ENTRIES },
  { id: "mini" as const, label: "GPT-5 mini", entries: MINI_ENTRIES },
];
---

<Base title={SITE_TITLE} description={HERO_SENTENCE}>
  <p class="relative z-10 mb-5 font-mono text-xs font-semibold uppercase tracking-[0.16em]">
    355 families · 3 websites · 6 conditions
  </p>

  <div class="relative">
    <span
      class="float-sticker sticker is-pink hidden rotate-[-8deg] lg:block"
      style="left: -1.25rem; top: 6.5rem"
      aria-hidden="true">src → tgt</span
    >
    <span
      class="float-sticker sticker hidden rotate-[7deg] lg:block"
      style="right: -0.75rem; top: 2.25rem"
      aria-hidden="true">10 slots</span
    >
  <OsWindow filename="skillshift.cover" badge="Issue 10-slot">
    <h1 class="max-w-3xl font-sans text-3xl leading-snug md:text-4xl">
      SkillShift-Bench measures whether a web agent’s learned skills still
      execute after the website itself has <mark class="pop">evolved</mark>.
    </h1>
    <aside
      class="hard-card mt-5 px-4 py-3 text-sm shadow-none"
      aria-label="Publication boundary"
    >
      <p class="mb-1 font-mono text-xs uppercase tracking-wide">
        Instrument boundary
      </p>
      <p>{BOUNDARY}</p>
    </aside>
    <p class="mt-4 font-mono text-xs text-stamp">
      GitLab {SITE_COUNTS.gitlab} · Magento {SITE_COUNTS.magento} · WordPress{" "}
      {SITE_COUNTS.wordpress} · src, src-perc, src-exec, tgt, tgt-perc, tgt-exec
    </p>

    <form class="series-switch mt-6" aria-label="SR readout">
      <p class="series-kicker">SR readout</p>
      <div class="series-banks">
        {
          banks.map((bank) => (
            <fieldset class="series-bank">
              <legend>{bank.label}</legend>
              <div class="series-chips">
                {bank.entries.map((entry) => (
                  <label class="series-chip">
                    <input
                      class="sr-only"
                      type="radio"
                      name="series"
                      value={entry.slug}
                      data-series={seriesKey(entry.slug)}
                      checked={entry.slug === defaultSlug}
                    />
                    <span class="series-chip-name">
                      {entry.json.submission.name}
                    </span>
                    <span class="series-chip-sr tabular">
                      {overallText(entry)}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
      </div>
      <div class="plates mt-4">
        {
          series.map((entry) => (
            <div
              class="plate-panel"
              data-slug={entry.slug}
              data-series={seriesKey(entry.slug)}
            >
              <Faceplate
                cells={cellsForMetric(entry.json, "SR")}
                metric="SR"
                heading={`${entry.json.submission.name} · ${displayModel(entry.model)}`}
              />
            </div>
          ))
        }
      </div>
      <p class="readout-key">
        Empty = unmeasured · -- = N/A · oxide = execution
      </p>
    </form>
    <p class="mt-6">
      <a class="btn-canary" href="/leaderboard">Open the leaderboard →</a>
    </p>
  </OsWindow>
  </div>

  <OsWindow class="mt-10" filename="shift.modes" badge="3 named">
    <h2 class="text-xl">Three named shifts</h2>
    <p class="mt-2 max-w-2xl">
      A skill has to be invoked, grounded, and executed. SkillShift-Bench names
      those three failure modes as run conditions. Execution is the steepest SR
      drop in every launch series.
    </p>
    <dl class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="hard-card p-3">
        <dt class="font-semibold">Contextual</dt>
        <dd class="mt-1 text-sm">
          Same task after the site’s version or theme changes. Routes and chrome
          move; the goal does not.
        </dd>
      </div>
      <div class="hard-card p-3">
        <dt class="font-semibold">Perceptual</dt>
        <dd class="mt-1 text-sm">
          Same task under altered layout, DOM, and locator evidence. The objects
          stay aligned.
        </dd>
      </div>
      <div class="hard-card p-3">
        <dt class="font-semibold">
          Execution <span class="sticker ml-1 align-middle">oxide</span>
        </dt>
        <dd class="mt-1 text-sm">
          Same task with reproducible runtime blockers. This is where learned
          skills collapse on the launch board.
        </dd>
      </div>
    </dl>

    <figure class="paper-fig mt-8">
      <ShiftRig />
      <figcaption>
        Schematic toy admin UI, not a live capture. Contextual moves chrome,
        routes, and object placement. Perceptual swaps locators in place.
        Execution raises an oxide runtime blocker. 0 is the source the skill
        was learned on.
      </figcaption>
    </figure>
  </OsWindow>

  <OsWindow class="mt-10" filename="slope.json" badge="Table 1 · 3">
    <h2 class="text-xl">Execution drop, from the launch JSON</h2>
    <p class="max-w-2xl text-sm">
      Two instrument banks, not one ranking. Lines are SR by condition. The
      table is the source of truth.
    </p>
    <figure class="mt-6">
      <h3 class="mb-2 text-sm font-semibold">Mixed backbones — Table 1</h3>
      <div class="slope-frame">
        <SlopeChart payload={mixedChart} class="is-tall" />
      </div>
      <figcaption class="mt-2 font-mono text-xs">{slopeCaption("mixed")}</figcaption>
    </figure>
    <figure class="readout mt-4">
      <figcaption>SR (%) by condition, mixed backbones</figcaption>
      <div class="readout-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Method</th>
              {
                CONDITIONS.map((c) => (
                  <th scope="col" class:list={[isExecSlot(c) && "is-exec"]}>
                    {c}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              MIXED_ENTRIES.map((e) => (
                <tr>
                  <th scope="row">{e.json.submission.name}</th>
                  {CONDITIONS.map((c) => {
                    const v = getSlotValue(e.json.metrics.SR, c);
                    const exec = isExecSlot(c);
                    if (v === null) {
                      return (
                        <td class:list={["is-empty", exec && "is-exec"]}>
                          unmeasured
                        </td>
                      );
                    }
                    return (
                      <td class:list={["cell-num", exec && "is-exec"]}>
                        {v.toFixed(2)}
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </figure>
    <figure class="mt-8">
      <h3 class="mb-2 text-sm font-semibold">gpt-5-mini — Table 3</h3>
      <div class="slope-frame">
        <SlopeChart payload={miniChart} />
      </div>
      <figcaption class="mt-2 font-mono text-xs">{slopeCaption("mini")}</figcaption>
    </figure>
    <figure class="readout mt-4">
      <figcaption>SR (%) by condition, gpt-5-mini</figcaption>
      <div class="readout-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Method</th>
              {
                CONDITIONS.map((c) => (
                  <th scope="col" class:list={[isExecSlot(c) && "is-exec"]}>
                    {c}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              MINI_ENTRIES.map((e) => (
                <tr>
                  <th scope="row">{e.json.submission.name}</th>
                  {CONDITIONS.map((c) => {
                    const v = getSlotValue(e.json.metrics.SR, c);
                    const exec = isExecSlot(c);
                    if (v === null) {
                      return (
                        <td class:list={["is-empty", exec && "is-exec"]}>
                          unmeasured
                        </td>
                      );
                    }
                    return (
                      <td class:list={["cell-num", exec && "is-exec"]}>
                        {v.toFixed(2)}
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </figure>
  </OsWindow>

  <OsWindow class="mt-10" filename="getting.started" badge="3 lines">
    <h2 class="text-xl">Getting started</h2>
    <CodeBlock filename="sh" code={GETTING_STARTED} />
    <p class="mt-4 flex flex-wrap gap-3">
      <a class="btn-canary text-xs" href="/docs/quickstart">Full quickstart →</a>
    </p>
  </OsWindow>

  <OsWindow class="mt-10" filename="cite.bib" badge="BibTeX">
    <h2 class="text-xl">Cite</h2>
    <CodeBlock filename="bib" code={BIBTEX} />
  </OsWindow>
</Base>

