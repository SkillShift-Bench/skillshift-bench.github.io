---
import Base from "../layouts/Base.astro";
import LeaderboardTable from "../components/LeaderboardTable.astro";
import OsWindow from "../components/OsWindow.astro";
import { SFR_SORT_HELPER, MODEL_LISTING_HELP } from "../lib/copy";
import { MODEL_LISTINGS } from "../lib/submissions";
import digests from "../data/digests.json";

const digestEntries = Object.entries(digests as Record<string, string>);

const requestedModel =
  Astro.url.searchParams.get("model") ||
  (Astro.url.searchParams.get("bank") === "mini" ? "gpt-5-mini" : "mixed");
const initialModel = MODEL_LISTINGS.some((l) => l.model === requestedModel)
  ? requestedModel
  : (MODEL_LISTINGS[0]?.model ?? "mixed");
---

<Base title="Leaderboard">
  <OsWindow filename="leaderboard.bank" badge="Ranked">
    <h1 class="text-3xl">Leaderboard</h1>
    <p class="mt-2 max-w-2xl font-serif">
      Ranked by overall SR within each listing. src and tgt-exec are the
      execution drop, not a second race.
    </p>

    <div class="board-ctrl mt-6" id="board-controls">
      <div class="ctrl-row">
        <p class="ctrl-label">Sort by</p>
        <div class="ctrl-pills">
          <a class="min-h-11" href="?sort=sr" data-q="sort=sr">SR</a>
          <a class="min-h-11" href="?sort=as" data-q="sort=as">AS</a>
          <a class="min-h-11" href="?sort=asc" data-q="sort=asc">ASC</a>
          <span
            class="min-h-11"
            id="sfr-head"
            aria-disabled="true"
            aria-describedby="sfr-help">SFR</span
          >
        </div>
        <p id="sfr-help" class="ctrl-help">{SFR_SORT_HELPER}</p>
        <p id="sfr-ignored" class="ctrl-help is-warn" hidden>
          sort=sfr was ignored. {SFR_SORT_HELPER}
        </p>
      </div>
      <div class="ctrl-row">
        <p class="ctrl-label">Model</p>
        <div class="ctrl-pills">
          {
            MODEL_LISTINGS.map((listing) => (
              <a
                class="min-h-11"
                href={`?model=${listing.model}`}
                data-q={`model=${listing.model}`}
              >
                {listing.label}
              </a>
            ))
          }
        </div>
        <p class="ctrl-help">{MODEL_LISTING_HELP}</p>
      </div>
    </div>

    <p class="mt-3 font-mono text-xs text-stamp">
      Bar wash is src SR; oxide fill is tgt-exec. The gap is the execution drop.
    </p>

    <div id="board" class="mt-8 space-y-12">
      {
        MODEL_LISTINGS.map((listing) => (
          <LeaderboardTable
            listingId={listing.model}
            title={listing.title}
            lede={listing.lede}
            entries={listing.entries}
            hidden={listing.model !== initialModel}
          />
        ))
      }
    </div>
  </OsWindow>

  <OsWindow class="mt-10" filename="env.digests" badge="skillshift-envs">
    <details>
      <summary class="digest-summary">Environment digests</summary>
      <p class="mt-2 text-sm">
        Official image digests from skillshift-envs. Launch rows did not run this
        harness; they carry no receipt.
      </p>
      <ul class="mt-3 space-y-1 font-mono text-xs">
        {
          digestEntries.map(([key, value]) => (
            <li>
              {key}: {value}
            </li>
          ))
        }
      </ul>
    </details>
  </OsWindow>
</Base>

<style>
  .ctrl-row + .ctrl-row {
    margin-top: 0.85rem;
  }
  .ctrl-label {
    margin: 0;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stamp);
  }
  .ctrl-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }
  .ctrl-help {
    margin: 0.4rem 0 0;
    max-width: 28rem;
    font-size: 0.75rem;
    color: var(--stamp);
  }
  .ctrl-help.is-warn {
    color: var(--oxide);
  }
  .digest-summary {
    cursor: pointer;
    font-size: 1.125rem;
    font-weight: 600;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  .digest-summary::before {
    content: "▸ ";
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--stamp);
  }
  details[open] .digest-summary::before {
    content: "▾ ";
  }
</style>

<script>
  function setOpen(row: HTMLElement, open: boolean, instant = false) {
    const btn = row.querySelector<HTMLButtonElement>(".row-toggle");
    const detail = row.querySelector<HTMLElement>(".board-detail");
    if (!btn || !detail) return;
    row.classList.toggle("is-instant", instant);
    btn.setAttribute("aria-expanded", String(open));
    row.classList.toggle("is-open", open);
    if (open) detail.removeAttribute("inert");
    else detail.setAttribute("inert", "");
  }

  function openFromHash() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const decoded = decodeURIComponent(hash);
    let target = document.getElementById(decoded);
    if (!target?.hasAttribute("data-entry")) {
      target = document.querySelector(
        `[data-entry][data-slug="${CSS.escape(decoded)}"]`,
      );
    }
    if (!target?.hasAttribute("data-entry")) return;
    const listing = target.closest<HTMLElement>("[data-listing]");
    if (listing?.dataset.listing) {
      document.querySelectorAll<HTMLElement>("[data-listing]").forEach((section) => {
        section.hidden = section.dataset.listing !== listing.dataset.listing;
      });
    }
    setOpen(target, true, true);
    target.scrollIntoView({ block: "start" });
  }

  function initBoard() {
    const board = document.getElementById("board");
    if (!board) return;

    if (!board.dataset.bound) {
      board.dataset.bound = "1";

      const params = new URLSearchParams(location.search);
      const ignored = document.getElementById("sfr-ignored");
      let sort = (params.get("sort") || "sr").toLowerCase();
      if (sort === "sfr") {
        ignored?.removeAttribute("hidden");
        sort = "sr";
      }
      if (!["sr", "as", "asc"].includes(sort)) sort = "sr";
      const dir = params.get("dir") === "asc" ? "asc" : "desc";
      const listingIds = [
        ...document.querySelectorAll<HTMLElement>("[data-listing]"),
      ].map((el) => el.dataset.listing || "");
      let model = params.get("model") || "";
      const legacyBank = params.get("bank") || "";
      if (!model) {
        if (legacyBank === "mini") model = "gpt-5-mini";
        else model = "mixed";
      }
      if (!listingIds.includes(model)) model = listingIds[0] || "mixed";

      document.querySelectorAll<HTMLElement>("[data-listing]").forEach((section) => {
        section.hidden = section.dataset.listing !== model;
      });

      function num(el: Element, key: string): number | null {
        const raw = (el as HTMLElement).dataset[key];
        if (raw === undefined || raw === "") return null;
        const n = Number(raw);
        return Number.isFinite(n) ? n : null;
      }

      function sortHost(host: Element) {
        const rows = [...host.querySelectorAll("[data-entry]")];
        rows.sort((a, b) => {
          const av = num(a, sort);
          const bv = num(b, sort);
          if (av === null && bv === null) return 0;
          if (av === null) return 1;
          if (bv === null) return -1;
          return dir === "desc" ? bv - av : av - bv;
        });
        rows.forEach((row, i) => {
          host.append(row);
          const rank = row.querySelector("[data-rank]");
          if (rank) rank.textContent = String(i + 1);
        });
      }

      document.querySelectorAll(".board-table").forEach(sortHost);

      document.querySelectorAll<HTMLElement>("[data-overall]").forEach((el) => {
        el.hidden = el.dataset.overall !== sort;
      });
      document.querySelectorAll("[data-overall-head]").forEach((el) => {
        el.textContent = sort.toUpperCase();
        el.setAttribute("aria-sort", dir === "asc" ? "ascending" : "descending");
      });

      document.querySelectorAll<HTMLElement>("[data-entry]").forEach((row) => {
        const btn = row.querySelector<HTMLButtonElement>(".row-toggle");
        btn?.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") !== "true";
          setOpen(row, open);
        });
      });

      document.querySelectorAll<HTMLAnchorElement>("[data-q]").forEach((a) => {
        const [k, v] = (a.dataset.q || "=").split("=");
        if (k === "sort" && v === sort) {
          a.classList.add("is-active");
          a.setAttribute("aria-current", "true");
        }
        if (k === "model" && v === model) {
          a.classList.add("is-active");
          a.setAttribute("aria-current", "true");
        }
        a.addEventListener("click", (event) => {
          event.preventDefault();
          if (k === "sort" && v === "sfr") return;
          const url = new URL(location.href);
          url.searchParams.set(k, v);
          if (k === "model") url.searchParams.delete("bank");
          history.replaceState(null, "", url);
          location.reload();
        });
      });
    }

    openFromHash();
  }

  const w = window as Window & { __ssbBoardHash?: boolean };
  if (!w.__ssbBoardHash) {
    w.__ssbBoardHash = true;
    window.addEventListener("hashchange", openFromHash);
  }

  initBoard();
</script>
