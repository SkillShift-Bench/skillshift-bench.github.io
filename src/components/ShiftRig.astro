---
const objects = [
  {
    id: "a",
    x: 40,
    label: "New project",
    srcLoc: "#new-project",
    tgtLoc: "//div[2]/button",
  },
  {
    id: "b",
    x: 204,
    label: "Star repo",
    srcLoc: "#star-btn",
    tgtLoc: ".css-a8f2",
  },
  {
    id: "c",
    x: 368,
    label: "Issue list",
    srcLoc: "#issue-list",
    tgtLoc: "[data-qa=x]",
  },
] as const;
---

<div class="shift-rig" style="--ctx: 0; --perc: 0; --exec: 0">
  <svg
    class="stage"
    viewBox="16 12 688 284"
    width="688"
    height="284"
    role="img"
    aria-labelledby="shift-rig-title shift-rig-desc"
  >
    <title id="shift-rig-title">Schematic web UI under three named shifts</title>
    <desc id="shift-rig-desc">
      A toy admin window. Contextual replaces chrome, routes, and object
      placement. Perceptual swaps locator attributes on the same three objects
      without moving them. Execution raises an oxide runtime blocker over the
      Run skill control.
    </desc>
    <defs>
      <pattern
        id="shift-rig-hatch"
        width="8"
        height="8"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(-45)"
      >
        <line
          x1="0"
          y1="0"
          x2="0"
          y2="8"
          stroke="var(--oxide)"
          stroke-width="3"></line>
      </pattern>
    </defs>

    <rect
      x="16"
      y="12"
      width="688"
      height="284"
      fill="var(--plate)"></rect>

    <rect x="16" y="12" width="688" height="32" fill="var(--titlebar)"></rect>
    <rect
      class="xfade as-tgt"
      x="16"
      y="12"
      width="688"
      height="32"
      fill="var(--pink)"></rect>
    <line
      x1="16"
      y1="44"
      x2="704"
      y2="44"
      stroke="var(--ink)"
      stroke-width="3"></line>
    <g aria-hidden="true">
      <circle
        cx="36"
        cy="28"
        r="5"
        fill="#ff5a5a"
        stroke="var(--ink)"
        stroke-width="2"></circle>
      <circle
        cx="52"
        cy="28"
        r="5"
        fill="var(--canary)"
        stroke="var(--ink)"
        stroke-width="2"></circle>
      <circle
        cx="68"
        cy="28"
        r="5"
        fill="var(--lime)"
        stroke="var(--ink)"
        stroke-width="2"></circle>
    </g>
    <text class="xfade chrome-src mono" x="88" y="33" fill="var(--ink)" font-size="12">
      src.app / projects
    </text>
    <text class="xfade chrome-tgt mono" x="88" y="33" fill="var(--ink)" font-size="12">
      tgt.app / home
    </text>
    <g class="xfade chrome-src">
      <rect
        x="620"
        y="18"
        width="72"
        height="20"
        fill="var(--lime)"
        stroke="var(--ink)"
        stroke-width="2"></rect>
      <text
        class="mono"
        x="656"
        y="32"
        text-anchor="middle"
        fill="var(--ink)"
        font-size="11">v1</text>
    </g>
    <g class="xfade chrome-tgt">
      <rect
        x="620"
        y="18"
        width="72"
        height="20"
        fill="var(--canary)"
        stroke="var(--ink)"
        stroke-width="2"></rect>
      <text
        class="mono"
        x="656"
        y="32"
        text-anchor="middle"
        fill="var(--ink)"
        font-size="11">v2</text>
    </g>

    <rect x="16" y="44" width="688" height="28" fill="var(--plate)"></rect>
    <text class="xfade chrome-src mono" x="32" y="63" fill="var(--stamp)" font-size="12">
      https://src.local/projects
    </text>
    <text class="xfade chrome-tgt mono" x="32" y="63" fill="var(--stamp)" font-size="12">
      https://tgt.local/home?view=grid
    </text>
    <line
      x1="16"
      y1="72"
      x2="704"
      y2="72"
      stroke="var(--ink)"
      stroke-width="3"></line>

    <rect x="16" y="72" width="688" height="36" fill="var(--steel)"></rect>
    <g class="xfade chrome-src">
      <text x="36" y="95" fill="var(--plate)" font-size="13" font-weight="600"
        >Projects</text
      >
      <text x="132" y="95" fill="var(--plate)" font-size="13">Groups</text>
      <text x="212" y="95" fill="var(--plate)" font-size="13">Activity</text>
    </g>
    <g class="xfade chrome-tgt">
      <text x="36" y="95" fill="var(--plate)" font-size="13" font-weight="600"
        >Home</text
      >
      <text x="108" y="95" fill="var(--plate)" font-size="13">Explore</text>
      <text x="188" y="95" fill="var(--plate)" font-size="13">Search</text>
    </g>
    <line
      x1="16"
      y1="108"
      x2="704"
      y2="108"
      stroke="var(--ink)"
      stroke-width="3"></line>

    {
      objects.map((obj) => (
        <g class="obj" data-obj={obj.id} transform={`translate(${obj.x} 124)`}>
          <rect
            width="148"
            height="100"
            fill="var(--plate)"
            stroke="var(--ink)"
            stroke-width="3"></rect>
          <text x="12" y="24" fill="var(--ink)" font-size="13" font-weight="600">
            {obj.label}
          </text>
          <text
            class="loc-src mono"
            data-glitch="src"
            data-loc={obj.srcLoc}
            x="12"
            y="48"
            font-size="11">
            - {obj.srcLoc}
          </text>
          <line
            class="loc-strike"
            x1="12"
            y1="44"
            x2="136"
            y2="44"
            stroke="var(--ink)"
            stroke-width="2"></line>
          <text
            class="loc-tgt mono"
            data-glitch="tgt"
            data-loc={obj.tgtLoc}
            x="12"
            y="66"
            font-size="11">
            + {obj.tgtLoc}
          </text>
          <text class="mono" x="12" y="88" fill="var(--ink)" font-size="10">
            same object
          </text>
        </g>
      ))
    }

    <g transform="translate(532 124)">
      <rect
        width="156"
        height="100"
        fill="var(--titlebar)"
        stroke="var(--ink)"
        stroke-width="3"></rect>
      <text x="10" y="20" fill="var(--ink)" font-size="11" font-weight="600"
        >DOM evidence</text
      >
      <text class="loc-src mono" data-glitch="src" data-loc="ul > li.card" x="10" y="40" font-size="10">
        - ul &gt; li.card
      </text>
      <line
        class="loc-strike"
        x1="10"
        y1="36"
        x2="146"
        y2="36"
        stroke="var(--ink)"
        stroke-width="2"></line>
      <text class="loc-tgt mono" data-glitch="tgt" data-loc="div > div > span" x="10" y="54" font-size="10">
        + div &gt; div &gt; span
      </text>
      <text class="loc-src mono" data-glitch="src" data-loc="button#new-project" x="10" y="72" font-size="10">
        - button#new-project
      </text>
      <line
        class="loc-strike"
        x1="10"
        y1="68"
        x2="146"
        y2="68"
        stroke="var(--ink)"
        stroke-width="2"></line>
      <text class="loc-tgt mono" data-glitch="tgt" data-loc="[data-testid=n]" x="10" y="86" font-size="10">
        + [data-testid=n]
      </text>
    </g>

    <g transform="translate(40 240)">
      <rect
        width="148"
        height="40"
        fill="var(--canary)"
        stroke="var(--ink)"
        stroke-width="3"></rect>
      <text
        x="74"
        y="26"
        text-anchor="middle"
        fill="var(--ink)"
        font-size="13"
        font-weight="600">Run skill</text
      >
    </g>
    <text class="mono" x="204" y="266" fill="var(--stamp)" font-size="11">
      learned skill → this control
    </text>

    <g class="exec-layer">
      <rect
        x="16"
        y="108"
        width="688"
        height="188"
        fill="url(#shift-rig-hatch)"
        opacity="0.55"></rect>
      <rect
        x="220"
        y="158"
        width="280"
        height="88"
        fill="var(--plate)"
        stroke="var(--oxide)"
        stroke-width="3"></rect>
      <text
        x="360"
        y="194"
        text-anchor="middle"
        fill="var(--oxide)"
        font-size="16"
        font-weight="600">Runtime blocker</text
      >
      <text
        class="mono"
        x="360"
        y="218"
        text-anchor="middle"
        fill="var(--ink)"
        font-size="12">500 · skill cannot execute</text
      >
    </g>
  </svg>

  <form class="controls" autocomplete="off">
    <fieldset>
      <legend class="legend">Shift intensity</legend>
      <p class="hint">
        Left is the source the skill was learned on. Right is a full named
        shift.
      </p>
      <div class="sliders">
        <div class="slider" style="--shift: var(--ctx)">
          <label class="slider-name" for="shift-ctx">Contextual</label>
          <span class="slider-ends" aria-hidden="true">
            <span>source chrome</span>
            <span>target chrome</span>
          </span>
          <div class="slider-range">
            <input
              id="shift-ctx"
              type="range"
              name="contextual"
              data-shift="ctx"
              min="0"
              max="100"
              value="0"
              step="1"
              aria-valuetext="source chrome"
              aria-describedby="shift-rig-hint-ctx"
            />
            <span class="slider-knob" aria-hidden="true"></span>
          </div>
          <span class="sr-only" id="shift-rig-hint-ctx">
            Moves routes, window chrome, and object placement. The task goal
            does not change.
          </span>
        </div>
        <div class="slider" style="--shift: var(--perc)">
          <label class="slider-name" for="shift-perc">Perceptual</label>
          <span class="slider-ends" aria-hidden="true">
            <span>stable locators</span>
            <span>reshuffled DOM</span>
          </span>
          <div class="slider-range">
            <input
              id="shift-perc"
              type="range"
              name="perceptual"
              data-shift="perc"
              min="0"
              max="100"
              value="0"
              step="1"
              aria-valuetext="stable locators"
              aria-describedby="shift-rig-hint-perc"
            />
            <span class="slider-knob" aria-hidden="true"></span>
          </div>
          <span class="sr-only" id="shift-rig-hint-perc">
            Swaps locator attributes on the same three objects. Placement does
            not move.
          </span>
        </div>
        <div class="slider is-exec" style="--shift: var(--exec)">
          <label class="slider-name" for="shift-exec">Execution</label>
          <span class="slider-ends" aria-hidden="true">
            <span>clear path</span>
            <span>runtime blocked</span>
          </span>
          <div class="slider-range">
            <input
              id="shift-exec"
              type="range"
              name="execution"
              data-shift="exec"
              min="0"
              max="100"
              value="0"
              step="1"
              aria-valuetext="clear path"
              aria-describedby="shift-rig-hint-exec"
            />
            <span class="slider-knob" aria-hidden="true"></span>
          </div>
          <span class="sr-only" id="shift-rig-hint-exec">
            Raises a reproducible runtime blocker over the skill control. Oxide
            marks execution only.
          </span>
        </div>
      </div>
    </fieldset>
    <div class="toolbar">
      <button type="button" class="btn-ghost" data-reset>Reset to source</button>
      <p class="live" aria-live="polite" aria-atomic="true" data-live>
        All three shifts at source.
      </p>
    </div>
  </form>
</div>

<style>
  .shift-rig {
    --ctx: 0;
    --perc: 0;
    --exec: 0;
    --loc-add: #0b6e63;
  }

  :global(html[data-theme="dark"]) .shift-rig {
    --loc-add: #7ee0d0;
  }

  .stage {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 688 / 284;
    overflow: hidden;
    background: var(--plate);
    font-family: var(--font-sans);
  }

  .stage text.mono,
  .mono {
    font-family: var(--font-mono);
  }

  .xfade,
  .exec-layer {
    transition-property: opacity;
    transition-duration: 180ms;
    transition-timing-function: ease;
  }

  .as-tgt {
    opacity: var(--ctx);
  }

  .chrome-tgt {
    opacity: 0;
  }

  .loc-src,
  .loc-tgt,
  .loc-strike {
    transform-box: fill-box;
    transform-origin: 0% 50%;
  }

  .loc-src {
    fill: var(--stamp);
    opacity: calc(1 - var(--perc) * 0.42);
    transform: translateY(calc(var(--perc) * -4px));
  }

  .loc-tgt {
    fill: var(--loc-add);
    opacity: var(--perc);
    transform: translateY(calc((1 - var(--perc)) * 8px));
  }

  .loc-strike {
    opacity: var(--perc);
    transform: translateY(calc(var(--perc) * -4px));
  }

  @media (prefers-reduced-motion: reduce) {
    .loc-src,
    .loc-tgt,
    .loc-strike {
      transform: none;
    }
  }

  .exec-layer {
    opacity: var(--exec);
    pointer-events: none;
  }

  .controls {
    border-top: 3px solid var(--ink);
    padding: 0.75rem 1.1rem 0.85rem;
    background: var(--titlebar);
  }

  .controls fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .legend {
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0;
  }

  .hint {
    margin: 0.25rem 0 0.5rem;
    font-size: 0.8rem;
    max-width: 42rem;
  }

  .sliders {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem 1.25rem;
    width: 100%;
  }

  .slider {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "name"
      "range"
      "ends";
    gap: 0.05rem;
    align-items: center;
    min-width: 0;
    width: 100%;
    max-width: 16rem;
    justify-self: center;
  }

  .slider-name {
    grid-area: name;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .slider-ends {
    grid-area: ends;
    display: flex;
    justify-content: space-between;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .slider-range {
    grid-area: range;
    position: relative;
    width: 100%;
    max-width: 16rem;
  }

  .slider-knob {
    position: absolute;
    top: 50%;
    left: calc(var(--shift, 0) * (100% - 1.35rem));
    width: 1.35rem;
    height: 1.35rem;
    margin-top: calc(-0.675rem - 1.5px);
    box-sizing: border-box;
    background: var(--canary);
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    pointer-events: none;
    transition-property: transform, box-shadow;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }

  .slider.is-exec .slider-knob {
    background: var(--oxide);
  }

  .slider-range.is-press .slider-knob {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .slider input[type="range"] {
    display: block;
    width: 100%;
    height: 2.25rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-appearance: none;
    appearance: none;
    accent-color: var(--canary);
  }

  .slider.is-exec input[type="range"] {
    accent-color: var(--oxide);
  }

  .slider input[type="range"]:focus-visible {
    outline: 3px solid var(--canary);
    outline-offset: 3px;
  }

  .slider input[type="range"]::-webkit-slider-runnable-track {
    height: 0.55rem;
    border: 3px solid var(--ink);
    background: var(--plate);
  }

  .slider input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: calc(-0.5rem - 1.5px);
    background: transparent;
    border: 3px solid transparent;
    box-shadow: none;
  }

  .slider input[type="range"]::-moz-range-track {
    height: 0.55rem;
    border: 3px solid var(--ink);
    background: var(--plate);
  }

  .slider input[type="range"]::-moz-range-thumb {
    width: 1.35rem;
    height: 1.35rem;
    background: transparent;
    border: 3px solid transparent;
    border-radius: 0;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .slider-range.is-press .slider-knob {
      transform: none;
    }
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.65rem;
  }

  .live {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (max-width: 639px) {
    .sliders {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const HOMES: Record<string, number> = { a: 40, b: 204, c: 368 };
  const Y = 124;
  const SLOT = 164;
  const AXIS_MS = 700;
  const AXES = ["ctx", "perc", "exec"] as const;

  function reducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function easeOut(t: number) {
    return 1 - (1 - t) * (1 - t);
  }

  const GLITCH = "█▓▒░#@*%!?<>/\\+=01xX$";

  function hash(i: number, frame: number, salt: number) {
    let x =
      Math.imul(i + 1, 374761393) ^
      Math.imul(frame + 1, 668265263) ^
      Math.imul(salt + 1, 1274126177);
    x = Math.imul(x ^ (x >>> 13), 1274126177);
    return x >>> 0;
  }

  function glyph(i: number, frame: number, salt: number) {
    return GLITCH[hash(i, frame, salt) % GLITCH.length];
  }

  function corruptSrc(src: string, t: number, frame: number, salt: number) {
    if (t <= 0 || t >= 1) return src;
    const peak = 1 - Math.abs(2 * t - 1);
    let out = "";
    for (let i = 0; i < src.length; i++) {
      const ch = src[i];
      if (ch === " ") {
        out += ch;
        continue;
      }
      const noise = (hash(i, frame, salt) % 1000) / 1000;
      out += noise < peak * 0.94 ? glyph(i, frame, salt) : ch;
    }
    return out;
  }

  function decodeTgt(to: string, t: number, frame: number, salt: number) {
    if (t <= 0) return to;
    if (t >= 1) return to;
    const lock = t * t * to.length;
    let out = "";
    for (let i = 0; i < to.length; i++) {
      if (to[i] === " " || i < lock) out += to[i];
      else out += glyph(i, frame, salt);
    }
    return out;
  }

  function phrase(shift: string, n: number): string {
    if (shift === "exec") {
      if (n === 0) return "clear path";
      if (n === 100) return "runtime blocked";
      return `${n} percent blocked`;
    }
    const src = shift === "ctx" ? "source chrome" : "stable locators";
    const tgt = shift === "ctx" ? "target chrome" : "reshuffled DOM";
    if (n === 0) return src;
    if (n === 100) return tgt;
    return `${n} percent shifted`;
  }

  function bind(root: HTMLElement) {
    const live = root.querySelector<HTMLElement>("[data-live]");
    const objs = [...root.querySelectorAll<SVGGElement>("[data-obj]")];
    const locNodes = [...root.querySelectorAll<SVGTextElement>("[data-glitch]")];
    let raf = 0;
    let cancelled = false;
    let playing = false;
    let played = false;
    let glitchFrame = 0;
    let lastGlitchPerc = Number(
      root.querySelector<HTMLInputElement>('[data-shift="perc"]')?.value || 0,
    );

    function paintLocators(t: number, frame: number) {
      const freeze = reducedMotion() || t <= 0 || t >= 1;
      locNodes.forEach((el, salt) => {
        const raw = el.dataset.loc || "";
        const kind = el.dataset.glitch;
        if (freeze) {
          el.textContent = kind === "src" ? `- ${raw}` : `+ ${raw}`;
          return;
        }
        if (kind === "src") {
          el.textContent = `- ${corruptSrc(raw, t, frame, salt)}`;
        } else {
          el.textContent = `+ ${decodeTgt(raw, t, frame, salt)}`;
        }
      });
    }

    function paint() {
      const values: Record<string, number> = { ctx: 0, perc: 0, exec: 0 };
      root
        .querySelectorAll<HTMLInputElement>("[data-shift]")
        .forEach((input) => {
          const key = input.dataset.shift || "";
          const n = Number(input.value);
          values[key] = n;
          root.style.setProperty(`--${key}`, String(n / 100));
          input.setAttribute("aria-valuetext", phrase(key, n));
        });
      const t = values.ctx / 100;
      objs.forEach((g) => {
        const id = g.dataset.obj || "";
        const home = HOMES[id] ?? 0;
        let dx = 0;
        if (id === "a" || id === "b") dx = t * SLOT;
        if (id === "c") dx = t * -2 * SLOT;
        g.setAttribute("transform", `translate(${home + dx} ${Y})`);
      });
      const setOp = (sel: string, on: boolean) => {
        root.querySelectorAll<SVGElement>(sel).forEach((el) => {
          el.style.opacity = on ? "1" : "0";
        });
      };
      setOp(".chrome-src", values.ctx < 50);
      setOp(".chrome-tgt", values.ctx >= 50);
      const perc = values.perc;
      const delta = Math.abs(perc - lastGlitchPerc);
      lastGlitchPerc = perc;
      if (delta > 0 && !reducedMotion() && perc > 0 && perc < 100) {
        glitchFrame += Math.max(1, Math.round(delta * 2));
      }
      paintLocators(perc / 100, glitchFrame);
      return values;
    }

    function announce(values: Record<string, number>) {
      if (!live) return;
      if (values.ctx === 0 && values.perc === 0 && values.exec === 0) {
        live.textContent = "All three shifts at source.";
        return;
      }
      live.textContent = `Contextual ${phrase("ctx", values.ctx)}. Perceptual ${phrase("perc", values.perc)}. Execution ${phrase("exec", values.exec)}.`;
    }

    function allZero() {
      return [...root.querySelectorAll<HTMLInputElement>("[data-shift]")].every(
        (input) => Number(input.value) === 0,
      );
    }

    function setAxis(key: string, n: number) {
      const input = root.querySelector<HTMLInputElement>(`[data-shift="${key}"]`);
      if (input) input.value = String(Math.round(n));
    }

    function cancelPlay() {
      cancelled = true;
      playing = false;
      if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    function runAxis(key: string): Promise<void> {
      return new Promise((resolve) => {
        const start = performance.now();
        const tick = (now: number) => {
          if (cancelled) {
            resolve();
            return;
          }
          const t = Math.min(1, (now - start) / AXIS_MS);
          setAxis(key, easeOut(t) * 100);
          paint();
          if (t < 1) {
            raf = requestAnimationFrame(tick);
          } else {
            resolve();
          }
        };
        raf = requestAnimationFrame(tick);
      });
    }

    async function autoplay() {
      if (played || playing || reducedMotion() || !allZero()) return;
      played = true;
      playing = true;
      cancelled = false;
      for (const axis of AXES) {
        if (cancelled) break;
        await runAxis(axis);
      }
      playing = false;
      announce(paint());
    }

    function stopForUser() {
      played = true;
      if (playing) {
        cancelPlay();
        announce(paint());
      }
    }

    function armPlay() {
      if (reducedMotion() || played) return;
      if (!("IntersectionObserver" in window)) {
        void autoplay();
        return;
      }
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            obs.disconnect();
            void autoplay();
          }
        },
        { threshold: 0.35 },
      );
      io.observe(root);
    }

    function overKnob(knob: Element, e: PointerEvent) {
      const box = knob.getBoundingClientRect();
      return (
        e.clientX >= box.left &&
        e.clientX <= box.right &&
        e.clientY >= box.top &&
        e.clientY <= box.bottom
      );
    }

    function bindKnobPress(input: HTMLInputElement) {
      const range = input.closest(".slider-range");
      const knob = range?.querySelector(".slider-knob");
      if (!(range instanceof HTMLElement) || !knob) return;

      const syncPress = (e: PointerEvent) => {
        range.classList.toggle("is-press", overKnob(knob, e));
      };

      input.addEventListener("pointermove", syncPress);
      input.addEventListener("pointerdown", syncPress);
      input.addEventListener("pointerup", syncPress);
      input.addEventListener("pointercancel", () => {
        range.classList.remove("is-press");
      });
      input.addEventListener("pointerleave", () => {
        range.classList.remove("is-press");
      });
    }

    root.querySelectorAll<HTMLInputElement>("[data-shift]").forEach((input) => {
      bindKnobPress(input);
      input.addEventListener("pointerdown", stopForUser);
      input.addEventListener("input", () => {
        stopForUser();
        paint();
      });
      input.addEventListener("change", () => {
        announce(paint());
      });
    });

    root.querySelector("[data-reset]")?.addEventListener("click", () => {
      stopForUser();
      root
        .querySelectorAll<HTMLInputElement>("[data-shift]")
        .forEach((input) => {
          input.value = "0";
        });
      announce(paint());
    });

    paint();
    armPlay();
  }

  const BIND = "perc-drag-glitch";

  function bindRigs() {
    document.querySelectorAll<HTMLElement>(".shift-rig").forEach((node) => {
      let root = node;
      if (root.dataset.bound === BIND) return;
      if (root.dataset.bound) {
        const fresh = root.cloneNode(true) as HTMLElement;
        delete fresh.dataset.bound;
        root.replaceWith(fresh);
        root = fresh;
      }
      root.dataset.bound = BIND;
      bind(root);
    });
  }

  bindRigs();
</script>
