---
import { formatNumber } from "../lib/cells";

interface Props {
  src: number | null;
  tgtExec: number | null;
  srcPct: number | null;
  execPct: number | null;
}

const { src, tgtExec, srcPct, execPct } = Astro.props;
const missing = srcPct === null || execPct === null;
const label = missing
  ? "Execution drop unmeasured"
  : `src ${formatNumber(src as number)} percent, tgt-exec ${formatNumber(tgtExec as number)} percent`;
---

{
  missing ? (
    <span class="score-bar-empty" aria-label={label}>
      —
    </span>
  ) : (
    <div class="score-bar" role="img" aria-label={label}>
      <span class="score-bar-track">
        <span class="score-bar-src" style={`width: ${srcPct}%`}></span>
        <span class="score-bar-exec" style={`width: ${execPct}%`}></span>
      </span>
    </div>
  )
}

<style>
  .score-bar {
    display: block;
    min-width: 7.5rem;
    width: 100%;
  }
  .score-bar-track {
    position: relative;
    display: block;
    height: 0.7rem;
    border: 2px solid var(--ink);
    background: color-mix(in srgb, var(--socket) 8%, var(--plate));
    overflow: hidden;
  }
  .score-bar-src,
  .score-bar-exec {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition-property: transform;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
  }
  .score-bar.is-in .score-bar-src,
  .score-bar.is-in .score-bar-exec {
    transform: scaleX(1);
  }
  .score-bar-src {
    background: color-mix(in srgb, var(--steel) 38%, var(--plate));
  }
  .score-bar-exec {
    background: var(--oxide);
  }
  .score-bar-empty {
    font-family: var(--font-mono);
    color: var(--stamp);
  }
</style>

<script>
  function revealScoreBars() {
    const bars = [
      ...document.querySelectorAll<HTMLElement>(".score-bar:not(.is-in)"),
    ];
    if (!bars.length) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced || !("IntersectionObserver" in window)) {
      bars.forEach((bar) => bar.classList.add("is-in"));
      return;
    }
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          obs.unobserve(entry.target);
        }
      },
      { threshold: 0.15 },
    );
    bars.forEach((bar) => io.observe(bar));
  }

  document.addEventListener("ssb:reveal-bars", revealScoreBars);
  revealScoreBars();
</script>
