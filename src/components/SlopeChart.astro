---
import type { SlopeChartPayload } from "../lib/slope";

interface Props {
  payload: SlopeChartPayload;
  class?: string;
}

const { payload, class: className } = Astro.props;
---

<div
  class:list={["slope-chart", className]}
  data-slope-chart={JSON.stringify(payload)}
  role="img"
  aria-label={`${payload.title}. Success rate by condition.`}
>
</div>

<script>
  function loadSlopeCharts() {
    const roots = document.querySelectorAll("[data-slope-chart]");
    if (!roots.length) return;
    const w = window as Window & { __ssbSlopeLazy?: boolean };
    if (w.__ssbSlopeLazy) return;
    w.__ssbSlopeLazy = true;

    // Fetch the ECharts chunk as soon as the page is interactive so scrolling
    // to the slope section does not wait on a 576 KB download. First paint
    // still only pays this 1.6 KB loader.
    import("../lib/slope-chart").then((mod) => mod.mountSlopeCharts());
  }

  loadSlopeCharts();
</script>
