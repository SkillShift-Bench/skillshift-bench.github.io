---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["brand-mark", className]}
  viewBox="0 0 32 32"
  width="32"
  height="32"
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
>
  <rect width="32" height="32" fill="#f7f1e3"></rect>
  <rect
    x="1"
    y="1"
    width="30"
    height="30"
    fill="none"
    stroke="#111111"
    stroke-width="2"></rect>
  <rect x="4" y="7" width="3" height="20" fill="#111111"></rect>
  <rect x="8" y="11" width="3" height="16" fill="#111111"></rect>
  <rect x="12" y="19" width="3" height="8" fill="#e23a1a"></rect>
  <rect x="16" y="13" width="3" height="14" fill="#111111"></rect>
  <rect x="20" y="15" width="3" height="12" fill="#111111"></rect>
  <rect x="24" y="21" width="3" height="6" fill="#e23a1a"></rect>
</svg>
